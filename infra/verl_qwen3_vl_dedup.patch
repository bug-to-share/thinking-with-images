+def _deduplicate_vision_inputs(pixel_values, grid_thw, spatial_merge_size):
+    """Deduplicate identical images within one HF forward pass.
+
+    GRPO ``rollout.n > 1`` commonly creates several identical copies of the
+    same image.  The vision encoder is deterministic for Qwen3-VL, so running
+    it once and expanding the result is mathematically equivalent, including
+    gradient accumulation through the expansion.  This is opt-in because it
+    adds device-side equality checks and should be benchmarked per workload.
+    """
+    enabled = os.getenv("VERL_QWEN3_VL_DEDUP_VISION_INPUTS", "0").lower() in {"1", "true", "yes"}
+    if not enabled or pixel_values is None or grid_thw is None or grid_thw.shape[0] < 2:
+        return pixel_values, grid_thw, None
+
+    raw_spans = (grid_thw[:, 0] * grid_thw[:, 1] * grid_thw[:, 2]).tolist()
+    pixel_chunks = list(pixel_values.split(raw_spans))
+    unique_chunks = []
+    unique_grids = []
+    inverse = []
+    for grid, chunk in zip(grid_thw, pixel_chunks, strict=True):
+        found = None
+        for unique_idx, (unique_grid, unique_chunk) in enumerate(zip(unique_grids, unique_chunks, strict=True)):
+            if torch.equal(grid, unique_grid) and torch.equal(chunk, unique_chunk):
+                found = unique_idx
+                break
+        if found is None:
+            found = len(unique_chunks)
+            unique_grids.append(grid)
+            unique_chunks.append(chunk)
+        inverse.append(found)
+
+    if len(unique_chunks) == len(pixel_chunks):
+        return pixel_values, grid_thw, None
+    return torch.cat(unique_chunks, dim=0), torch.stack(unique_grids, dim=0), (inverse, spatial_merge_size)
+
+
+def _restore_deduplicated_features(features, restore_info, grid_thw):
+    if restore_info is None:
+        return features
+    inverse, spatial_merge_size = restore_info
+    feature_spans = (
+        grid_thw[:, 0] * grid_thw[:, 1] * grid_thw[:, 2] // (spatial_merge_size**2)
+    ).tolist()
+    unique_features = list(features.split(feature_spans))
+    return torch.cat([unique_features[idx] for idx in inverse], dim=0)
+
+
+def _restore_deduplicated_feature_list(features, restore_info, grid_thw):
+    if restore_info is None:
+        return features
+    return [_restore_deduplicated_features(feature, restore_info, grid_thw) for feature in features]
+
+
