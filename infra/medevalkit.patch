new file mode 100644
--- /dev/null
+++ b/custom_prompt.py
@@ -0,0 +1,185 @@
+"""Global custom-prompt support for MedEvalKit evaluation runs."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+from typing import Any, Mapping
+
+
+_APPLIED_MARKER = "_medevalkit_custom_prompt_applied"
+
+
+def load_custom_prompt_config(path: str | Path) -> dict[str, Any]:
+    config_path = Path(path).expanduser().resolve()
+    with config_path.open("r", encoding="utf-8") as handle:
+        config = json.load(handle)
+
+    if not isinstance(config, dict):
+        raise ValueError("Custom prompt config must be a JSON object")
+    if not isinstance(config.get("user_prompt_template"), str):
+        raise ValueError(
+            "Custom prompt config requires a string 'user_prompt_template'"
+        )
+    if "system_prompt" in config and not isinstance(config["system_prompt"], str):
+        raise ValueError("'system_prompt' must be a string when provided")
+    return config
+
+
+def _original_prompt(messages: Mapping[str, Any]) -> str:
+    if isinstance(messages.get("prompt"), str):
+        return messages["prompt"]
+
+    conversation = messages.get("messages")
+    if isinstance(conversation, list):
+        for message in reversed(conversation):
+            if not isinstance(message, Mapping) or message.get("role") != "user":
+                continue
+            content = message.get("content", "")
+            if isinstance(content, str):
+                return content
+            if isinstance(content, list):
+                texts = [
+                    item.get("text", "")
+                    for item in content
+                    if isinstance(item, Mapping) and item.get("type") == "text"
+                ]
+                return "\n".join(text for text in texts if text)
+    return ""
+
+
+def _template_context(
+    messages: Mapping[str, Any], sample: Mapping[str, Any] | None
+) -> dict[str, Any]:
+    original_prompt = _original_prompt(messages)
+    context = {
+        key: value
+        for key, value in (sample or {}).items()
+        if key != "messages" and isinstance(value, (str, int, float, bool))
+    }
+    context["original_prompt"] = original_prompt
+    context.setdefault("prompt", original_prompt)
+    context.setdefault("question", original_prompt)
+    return context
+
+
+def _render_user_prompt(
+    config: Mapping[str, Any],
+    messages: Mapping[str, Any],
+    sample: Mapping[str, Any] | None,
+) -> str:
+    context = _template_context(messages, sample)
+    try:
+        return config["user_prompt_template"].format_map(context)
+    except KeyError as exc:
+        available = ", ".join(sorted(context))
+        raise ValueError(
+            f"Unknown custom prompt field {exc.args[0]!r}; available fields: {available}"
+        ) from exc
+
+
+def _replace_conversation_user_content(
+    conversation: list[Any], user_prompt: str, system_prompt: str | None
+) -> list[Any]:
+    updated = [dict(message) if isinstance(message, Mapping) else message for message in conversation]
+
+    if system_prompt is not None:
+        updated = [
+            message
+            for message in updated
+            if not (isinstance(message, Mapping) and message.get("role") == "system")
+        ]
+        if system_prompt:
+            updated.insert(0, {"role": "system", "content": system_prompt})
+
+    user_index = next(
+        (
+            index
+            for index in range(len(updated) - 1, -1, -1)
+            if isinstance(updated[index], Mapping)
+            and updated[index].get("role") == "user"
+        ),
+        None,
+    )
+    if user_index is None:
+        updated.append({"role": "user", "content": user_prompt})
+        return updated
+
+    user_message = dict(updated[user_index])
+    content = user_message.get("content")
+    if isinstance(content, list):
+        non_text_content = [
+            item
+            for item in content
+            if not (isinstance(item, Mapping) and item.get("type") == "text")
+        ]
+        user_message["content"] = non_text_content + [
+            {"type": "text", "text": user_prompt}
+        ]
+    else:
+        user_message["content"] = user_prompt
+    updated[user_index] = user_message
+    return updated
+
+
+def apply_custom_prompt(
+    messages: Mapping[str, Any],
+    config: Mapping[str, Any],
+    sample: Mapping[str, Any] | None = None,
+) -> dict[str, Any]:
+    """Return messages with only their system/user text overridden."""
+
+    if messages.get(_APPLIED_MARKER):
+        return dict(messages)
+
+    # Keep PIL images and other media objects by reference; only prompt containers change.
+    updated = dict(messages)
+    user_prompt = _render_user_prompt(config, messages, sample)
+    system_prompt = config.get("system_prompt") if "system_prompt" in config else None
+
+    if isinstance(updated.get("messages"), list):
+        updated["messages"] = _replace_conversation_user_content(
+            updated["messages"], user_prompt, system_prompt
+        )
+    else:
+        updated["prompt"] = user_prompt
+        if system_prompt is not None:
+            if system_prompt:
+                updated["system"] = system_prompt
+            else:
+                updated.pop("system", None)
+
+    updated[_APPLIED_MARKER] = True
+    return updated
+
+
+def apply_custom_prompt_to_samples(
+    samples: list[dict[str, Any]], config: Mapping[str, Any]
+) -> None:
+    for index, sample in enumerate(samples):
+        messages = sample.get("messages")
+        if not isinstance(messages, Mapping):
+            raise ValueError(
+                f"Sample {index} does not expose a supported 'messages' mapping"
+            )
+        sample["messages"] = apply_custom_prompt(messages, config, sample)
+
+
+class CustomPromptModel:
+    """Model proxy that also covers benchmarks constructing messages at eval time."""
+
+    def __init__(self, model: Any, config: Mapping[str, Any]):
+        self._model = model
+        self._config = config
+
+    def __getattr__(self, name: str) -> Any:
+        return getattr(self._model, name)
+
+    def generate_output(self, messages: Mapping[str, Any]) -> Any:
+        return self._model.generate_output(apply_custom_prompt(messages, self._config))
+
+    def generate_outputs(self, messages_list: list[Mapping[str, Any]]) -> Any:
+        custom_messages = [
+            apply_custom_prompt(messages, self._config) for messages in messages_list
+        ]
+        return self._model.generate_outputs(custom_messages)
